<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Property"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#0F5F3A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Complete the property details for users to view."
            android:textSize="15sp"
            android:textColor="#555555"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:id="@+id/imgProperty"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:scaleType="centerCrop"
            android:background="#D9EDE4"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSelectImage"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Select Property Image"
            android:textColor="#0F5F3A"
            android:backgroundTint="#D9EDE4"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Basic Information"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F5F3A"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Property Title"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Location"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Price, example: 280000"
            android:inputType="numberDecimal"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property Type"
            android:textStyle="bold"
            android:textColor="#0F5F3A"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#FFFFFF"/>

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Description"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:minLines="4"
            android:gravity="top"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property Features"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F5F3A"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etBedrooms"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Bedrooms, example: 4"
            android:inputType="number"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <EditText
            android:id="@+id/etBathrooms"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Bathrooms, example: 3"
            android:inputType="number"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etBuiltUpArea"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Built-up Area, example: 2200"
            android:inputType="number"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etParking"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Parking, example: 2"
            android:inputType="number"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agent &amp; Rental Information"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F5F3A"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etAgentName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Agent Name"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <EditText
            android:id="@+id/etAgentPhone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Agent Phone, example: 0123456789"
            android:inputType="phone"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property Status"
            android:textStyle="bold"
            android:textColor="#0F5F3A"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spStatus"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#FFFFFF"/>

        <EditText
            android:id="@+id/etTourUrl"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Virtual Tour URL (optional)"
            android:inputType="textUri"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnSaveProperty"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Save Property"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E7A5A"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>