<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6">

    <LinearLayout
        android:id="@+id/propertyContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Properties"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#0F5F3A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search and filter properties that match your needs."
            android:textSize="15sp"
            android:textColor="#777777"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etSearchProperty"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Search by title or location"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property Type"
            android:textStyle="bold"
            android:textColor="#0F5F3A"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spFilterType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property Status"
            android:textStyle="bold"
            android:textColor="#0F5F3A"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spFilterStatus"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnApplyFilter"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="Apply Filter"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E7A5A" />

            <Button
                android:id="@+id/btnResetFilter"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="Reset"
                android:textColor="#0F5F3A"
                android:backgroundTint="#D9EDE4"
                android:layout_marginLeft="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>