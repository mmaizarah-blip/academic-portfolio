<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Property Analytics"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#0F5F3A"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overview of your property listings."
            android:textSize="15sp"
            android:textColor="#555555"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvMyListings"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="🏠 My Listings: 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center_vertical"
            android:padding="22dp"
            android:background="#0F5F3A"/>

        <TextView
            android:id="@+id/tvMyApproved"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="✅ Approved: 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0F5F3A"
            android:gravity="center_vertical"
            android:padding="22dp"
            android:background="#D9EDE4"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/tvMyPending"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="⏳ Pending: 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0F5F3A"
            android:gravity="center_vertical"
            android:padding="22dp"
            android:background="#D9EDE4"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/tvMyRented"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="🏡 Rented Properties: 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0F5F3A"
            android:gravity="center_vertical"
            android:padding="22dp"
            android:background="#D9EDE4"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/tvMyRevenue"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="💵 Revenue: RM 0.00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center_vertical"
            android:padding="22dp"
            android:background="#1E7A5A"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>